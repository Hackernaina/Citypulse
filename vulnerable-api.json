{
  "openapi": "3.0.0",
  "info": {
    "title": "SentinelAPI Demo Banking API",
    "version": "1.0.0"
  },
  "paths": {
    "/login": {
      "post": {
        "summary": "Login",
        "requestBody": {
          "required": true
        }
      }
    },
    "/users/{user_id}": {
      "get": {
        "summary": "Get user"
      }
    },
    "/orders/{order_id}": {
      "get": {
        "summary": "Get order",
        "security": [{"bearerAuth": []}]
      }
    },
    "/profile": {
      "get": {
        "summary": "Authenticated profile",
        "security": [{"bearerAuth": []}]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
